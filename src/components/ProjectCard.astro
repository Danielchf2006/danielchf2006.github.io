---
import type { CollectionEntry } from "astro:content";
import HoverImage from "@/components/HoverImage.astro";
import CountUp from "@/components/CountUp.astro";

interface Props {
  project: CollectionEntry<"projects">;
}
const { project } = Astro.props;
const { data, id } = project;
const href = `/projects/${id}`;
const coverSrc = data.cover ? `/images/projects/${id}/${data.cover}` : null;
---

<a class="card" href={href} data-tilt>
  <div class="card__media">
    {
      coverSrc ? (
        <HoverImage src={coverSrc} alt={data.coverAlt} width={800} height={500} />
      ) : (
        <div class="card__placeholder">
          <span>/images/projects/{id}/</span>
        </div>
      )
    }
  </div>

  <div class="card__body">
    <h3 class="card__title">{data.title}</h3>
    <p class="card__summary">{data.summary}</p>

    {
      data.metrics.length > 0 && (
        <dl class="card__metrics">
          {data.metrics.slice(0, 3).map((m) => (
            <div>
              <dt>{m.label}</dt>
              <dd>
                <CountUp value={m.value} />
              </dd>
            </div>
          ))}
        </dl>
      )
    }

    {
      data.stack.length > 0 && (
        <ul class="card__stack">
          {data.stack.slice(0, 6).map((s) => (
            <li>{s}</li>
          ))}
        </ul>
      )
    }
  </div>
</a>

<script>
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const MAX = 6; // deg

  document.querySelectorAll<HTMLElement>("[data-tilt]").forEach((el) => {
    const onMove = (e: PointerEvent) => {
      const r = el.getBoundingClientRect();
      const px = (e.clientX - r.left) / r.width;
      const py = (e.clientY - r.top) / r.height;
      el.style.setProperty("--mx", `${(px * 100).toFixed(1)}%`);
      el.style.setProperty("--my", `${(py * 100).toFixed(1)}%`);
      if (!reduce) {
        el.style.setProperty("--rx", `${((0.5 - py) * MAX).toFixed(2)}deg`);
        el.style.setProperty("--ry", `${((px - 0.5) * MAX).toFixed(2)}deg`);
      }
    };
    const reset = () => {
      el.style.setProperty("--rx", "0deg");
      el.style.setProperty("--ry", "0deg");
    };
    el.addEventListener("pointermove", onMove);
    el.addEventListener("pointerleave", reset);
  });
</script>

<style>
  .card {
    --rx: 0deg;
    --ry: 0deg;
    --mx: 50%;
    --my: 0%;
    position: relative;
    display: flex;
    flex-direction: column;
    border: var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--surface);
    color: var(--ink);
    transform: perspective(900px) rotateX(var(--rx)) rotateY(var(--ry));
    transition: transform 0.12s ease-out, box-shadow 0.15s ease;
  }
  .card::after {
    /* pointer-following spotlight */
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.2s ease;
    background: radial-gradient(
      18rem 18rem at var(--mx) var(--my),
      color-mix(in srgb, var(--accent) 22%, transparent),
      transparent 60%
    );
  }
  .card:hover {
    text-decoration: none;
    box-shadow: var(--shadow);
  }
  .card:hover::after {
    opacity: 1;
  }
  .card__media {
    aspect-ratio: 16 / 10;
    background-color: var(--surface);
    background-image: var(--dither);
    background-size: var(--dither-size);
    border-bottom: var(--border);
  }
  .card__placeholder {
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--accent-2);
  }
  .card__body {
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .card__title {
    margin: 0;
    font-size: var(--text-lg);
  }
  .card__summary {
    margin: 0;
    color: var(--muted);
    font-size: var(--text-sm);
  }
  .card__metrics {
    display: flex;
    gap: var(--space-6);
    margin: var(--space-1) 0 0;
  }
  .card__metrics div {
    display: flex;
    flex-direction: column-reverse;
  }
  .card__metrics dt {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .card__metrics dd {
    margin: 0;
    font-size: var(--text-lg);
    font-weight: 650;
  }
  .card__stack {
    list-style: none;
    padding: 0;
    margin: var(--space-2) 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .card__stack li {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--muted);
    border: var(--border);
    border-radius: var(--radius);
    padding: 0.15rem 0.55rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .card {
      transform: none;
    }
  }
</style>
