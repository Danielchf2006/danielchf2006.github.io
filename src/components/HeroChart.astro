---
/**
 * A decorative scatter + regression line for the homepage hero. The line
 * "draws" itself and the points pop in when it scrolls into view. Shaped
 * like a predicted-vs-actual plot — a nod to what the work actually is.
 *
 * Points are generated at build time with a seeded RNG so the SVG is
 * identical on every build (no hydration mismatch, no layout shift).
 */
interface Props {
  points?: number;
  class?: string;
}
const { points = 46, class: className }: Props = Astro.props;

// tiny seeded PRNG (mulberry32)
function rng(seed: number) {
  return () => {
    seed |= 0;
    seed = (seed + 0x6d2b79f5) | 0;
    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

const W = 640;
const H = 360;
const pad = 28;
const rand = rng(20280609);

// y = x line (predicted == actual) with gaussian-ish noise
const gauss = () => (rand() + rand() + rand() + rand() - 2) / 2;
const pts = Array.from({ length: points }, () => {
  const x = rand();
  const y = Math.min(1, Math.max(0, x + gauss() * 0.16));
  return {
    cx: +(pad + x * (W - pad * 2)).toFixed(1),
    cy: +(H - pad - y * (H - pad * 2)).toFixed(1),
    r: +(2.5 + rand() * 2).toFixed(1),
    d: +(rand() * 0.9).toFixed(2), // stagger delay
  };
});

const x1 = pad;
const y1 = H - pad;
const x2 = W - pad;
const y2 = pad;
---

<figure class:list={["herochart", className]} data-herochart aria-hidden="true">
  <svg viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMid meet">
    <line class="hc-axis" x1={pad} y1={H - pad} x2={W - pad} y2={H - pad} />
    <line class="hc-axis" x1={pad} y1={pad} x2={pad} y2={H - pad} />
    <line class="hc-fit" x1={x1} y1={y1} x2={x2} y2={y2} />
    {
      pts.map((p) => (
        <circle
          class="hc-pt"
          cx={p.cx}
          cy={p.cy}
          r={p.r}
          style={`--d:${p.d}s`}
        />
      ))
    }
  </svg>
  <figcaption>predicted vs. actual</figcaption>
</figure>

<script>
  const io = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        if (e.isIntersecting) {
          e.target.classList.add("is-live");
          io.unobserve(e.target);
        }
      }
    },
    { threshold: 0.35 },
  );
  document
    .querySelectorAll("[data-herochart]")
    .forEach((el) => io.observe(el));
</script>

<style>
  .herochart {
    margin: 0;
    width: 100%;
  }
  .herochart svg {
    width: 100%;
    height: auto;
    display: block;
    overflow: visible;
  }
  .hc-axis {
    stroke: var(--line);
    stroke-width: 1.5;
  }
  .hc-fit {
    stroke: var(--accent);
    stroke-width: 2;
    stroke-dasharray: 900;
    stroke-dashoffset: 900;
  }
  .hc-pt {
    fill: var(--accent-2);
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
  }
  .herochart figcaption {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--muted);
    margin-top: var(--space-2);
    letter-spacing: 0.08em;
  }

  .herochart.is-live .hc-fit {
    animation: hc-draw 1.3s cubic-bezier(0.65, 0, 0.35, 1) forwards;
  }
  .herochart.is-live .hc-pt {
    animation: hc-pop 0.5s ease-out forwards;
    animation-delay: var(--d);
  }
  @keyframes hc-draw {
    to {
      stroke-dashoffset: 0;
    }
  }
  @keyframes hc-pop {
    0% {
      opacity: 0;
      transform: scale(0.2);
    }
    70% {
      transform: scale(1.15);
    }
    100% {
      opacity: 0.8;
      transform: scale(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hc-fit {
      stroke-dashoffset: 0;
    }
    .hc-pt {
      opacity: 0.8;
    }
    .herochart.is-live .hc-fit,
    .herochart.is-live .hc-pt {
      animation: none;
    }
  }
</style>
