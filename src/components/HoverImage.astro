---
/**
 * An <img> that "reprocesses" on hover: it snaps to a chunky low-res block
 * grid, throws a quick RGB split, then resharpens to the crisp original.
 * Reads as the image being recomputed — on-theme for a data site.
 *
 * The real <img> is always in the DOM (SEO, no-JS, reduced-motion). The
 * effect is a <canvas> layered on top that only appears mid-animation.
 */
interface Props {
  src: string;
  alt?: string;
  width?: number;
  height?: number;
  /** object-fit for the image inside its box */
  fit?: "cover" | "contain";
  class?: string;
  loading?: "lazy" | "eager";
}
const {
  src,
  alt = "",
  width = 1200,
  height = 750,
  fit = "cover",
  class: className,
  loading = "lazy",
}: Props = Astro.props;
---

<div class:list={["hoverimg", className]} data-pixelate>
  <img
    src={src}
    alt={alt}
    width={width}
    height={height}
    loading={loading}
    decoding="async"
    draggable="false"
    style={`object-fit:${fit}`}
  />
  <canvas aria-hidden="true"></canvas>
</div>

<script>
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  function setup(el: HTMLElement) {
    const img = el.querySelector("img");
    const canvas = el.querySelector("canvas");
    if (!(img instanceof HTMLImageElement) || !(canvas instanceof HTMLCanvasElement)) return;
    const ctx = canvas.getContext("2d");
    if (!ctx) return;

    let timers: number[] = [];

    const cancel = () => {
      timers.forEach(clearTimeout);
      timers = [];
    };

    const hide = () => {
      cancel();
      canvas.style.opacity = "0";
    };

    // resolution ramp, in blocks across the width — small = chunky
    const STEPS = [8, 14, 24, 44, 84, 999];
    const STEP_MS = 55;

    const draw = (blocks: number, split: number) => {
      if (!img.naturalWidth) return;
      const rect = el.getBoundingClientRect();
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      const w = Math.round(rect.width);
      const h = Math.round(rect.height);
      if (canvas.width !== w * dpr || canvas.height !== h * dpr) {
        canvas.width = w * dpr;
        canvas.height = h * dpr;
      }
      canvas.style.width = w + "px";
      canvas.style.height = h + "px";
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, w, h);
      ctx.imageSmoothingEnabled = false;

      // cover-fit math
      const scale = Math.max(w / img.naturalWidth, h / img.naturalHeight);
      const dw = img.naturalWidth * scale;
      const dh = img.naturalHeight * scale;
      const dx = (w - dw) / 2;
      const dy = (h - dh) / 2;

      const bw = Math.max(1, Math.round(blocks));
      const bh = Math.max(1, Math.round((blocks * h) / w));
      // downscale to a tiny buffer then blow it back up = block grid
      const tmp = document.createElement("canvas");
      tmp.width = Math.min(bw, w);
      tmp.height = Math.min(bh, h);
      const tctx = tmp.getContext("2d");
      if (!tctx) return;
      tctx.imageSmoothingEnabled = false;
      tctx.drawImage(
        img,
        (dx * tmp.width) / w,
        (dy * tmp.height) / h,
        (dw * tmp.width) / w,
        (dh * tmp.height) / h,
      );

      if (split > 0) {
        ctx.globalCompositeOperation = "lighter";
        ctx.globalAlpha = 0.9;
        ctx.filter = "saturate(2)";
        ctx.drawImage(tmp, -split, 0, w, h);
        ctx.drawImage(tmp, split, 0, w, h);
        ctx.filter = "none";
        ctx.globalAlpha = 1;
        ctx.globalCompositeOperation = "source-over";
      } else {
        ctx.drawImage(tmp, 0, 0, w, h);
      }
    };

    const run = () => {
      cancel();
      if (reduce || !img.complete || !img.naturalWidth) return;
      canvas.style.opacity = "1";
      STEPS.forEach((blocks, i) => {
        timers.push(
          window.setTimeout(() => {
            const split = i === 1 || i === 2 ? 3 : 0;
            if (blocks >= 999) hide();
            else draw(blocks, split);
          }, i * STEP_MS),
        );
      });
    };

    el.addEventListener("mouseenter", run);
    el.addEventListener("focusin", run);
    el.addEventListener("mouseleave", hide);
    el.addEventListener("focusout", hide);
  }

  document
    .querySelectorAll<HTMLElement>("[data-pixelate]")
    .forEach(setup);
</script>

<style>
  .hoverimg {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }
  .hoverimg img {
    width: 100%;
    height: 100%;
    display: block;
  }
  .hoverimg canvas {
    position: absolute;
    inset: 0;
    opacity: 0;
    pointer-events: none;
    transition: opacity 90ms linear;
  }
</style>
