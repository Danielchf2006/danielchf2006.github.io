---
import { socials } from "@/data/site";
import PixelIcon from "@/components/PixelIcon.astro";

interface Props {
  align?: "start" | "center";
}
const { align = "start" } = Astro.props;
---

<ul class="social" data-align={align}>
  {
    socials.map((s) => (
      <li>
        <a
          href={s.href}
          target={s.href.startsWith("http") ? "_blank" : undefined}
          rel="noopener"
        >
          <span class="social__glyph">
            <PixelIcon name={s.icon} size={14} title={s.label} />
          </span>
          <span>{s.label}</span>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .social {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }
  .social[data-align="center"] {
    justify-content: center;
  }
  .social a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--muted);
  }
  .social a:hover {
    color: var(--accent);
    text-decoration: none;
  }
  .social a:hover .social__glyph {
    border-color: var(--accent);
    color: var(--accent);
  }
  .social__glyph {
    display: inline-grid;
    place-items: center;
    width: 1.6rem;
    height: 1.6rem;
    border: var(--border);
    color: var(--ink);
  }
</style>
