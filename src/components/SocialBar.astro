---
import { socials } from "@/data/site";
import PixelIcon from "@/components/PixelIcon.astro";

interface Props {
  align?: "start" | "center";
  /** icons only, no text labels (for the header) */
  iconOnly?: boolean;
  /** icon pixel size */
  size?: number;
}
const { align = "start", iconOnly = false, size = iconOnly ? 18 : 14 } =
  Astro.props;
---

<ul class:list={["social", { "social--icons": iconOnly }]} data-align={align}>
  {
    socials.map((s) => (
      <li>
        <a
          href={s.href}
          target={s.href.startsWith("http") ? "_blank" : undefined}
          rel="noopener"
          aria-label={s.label}
        >
          <span class="social__glyph">
            <PixelIcon name={s.icon} size={size} title={s.label} />
          </span>
          {!iconOnly && <span>{s.label}</span>}
        </a>
      </li>
    ))
  }
</ul>

<style>
  .social {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }
  .social[data-align="center"] {
    justify-content: center;
  }
  .social--icons {
    gap: var(--space-2);
  }
  .social a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--muted);
  }
  .social a:hover {
    color: var(--accent);
    text-decoration: none;
  }
  .social a:hover .social__glyph {
    border-color: var(--accent);
    color: var(--accent);
  }
  .social__glyph {
    display: inline-grid;
    place-items: center;
    width: 1.6rem;
    height: 1.6rem;
    border: var(--border);
    color: var(--ink);
  }
  .social--icons .social__glyph {
    width: 2rem;
    height: 2rem;
  }
</style>
