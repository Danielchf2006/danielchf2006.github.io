---
import GlitchText from "@/components/GlitchText.astro";

interface Props {
  eyebrow?: string;
  title: string;
  href?: string;
  linkLabel?: string;
}
const { eyebrow, title, href, linkLabel } = Astro.props;
---

<div class="section-heading">
  <div>
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <GlitchText text={title} as="h2" />
  </div>
  {href && <a class="section-heading__link" href={href}>{linkLabel ?? "View all"} →</a>}
</div>

<style>
  .section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-8);
  }
  .section-heading h2 {
    margin: var(--space-2) 0 0;
  }
  .section-heading__link {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    white-space: nowrap;
    padding-bottom: var(--space-1);
  }
</style>
