---
/**
 * Full-screen entry animation. Sits above everything, plays `site.intro.src`
 * (image clip or muted video), then dissolves into the site. Auto-dismisses
 * after `durationMs`; also dismissible by click / any key / scroll.
 *
 * The <html>.intro-off class (set pre-paint in BaseLayout's head) hides this
 * with display:none before it can flash — for reduced-motion viewers and for
 * repeat visits within a session.
 */
import { site } from "@/data/site";

const intro = site.intro;
const src = intro.src.trim();
const isVideo = /\.(mp4|webm|mov)$/i.test(src);
---

{
  intro.enabled && (
    <div
      id="intro"
      class="intro"
      data-no-glitch
      data-duration={intro.durationMs}
      data-once={String(intro.showOncePerSession)}
      role="dialog"
      aria-label="Site intro"
    >
      <div class:list={["intro__stage", { "is-pixel": intro.pixelated }]}>
        {src ? (
          isVideo ? (
            <video
              class="intro__media"
              src={src}
              autoplay
              muted
              playsinline
              preload="auto"
            />
          ) : (
            <img class="intro__media" src={src} alt="" decoding="async" />
          )
        ) : (
          <div class="intro__placeholder">
            <span data-text={site.name}>{site.name}</span>
            <em>loading&hellip;</em>
          </div>
        )}
      </div>

      <button type="button" class="intro__skip" data-intro-skip>
        skip &rarr;
      </button>
    </div>
  )
}

<script>
  const el = document.getElementById("intro");
  // skip entirely when the pre-paint script hid the overlay (reduced motion,
  // or already seen this session) — otherwise we'd scroll-lock behind nothing
  if (el && !document.documentElement.classList.contains("intro-off")) {
    const dur = Number(el.dataset.duration) || 2400;
    const once = el.dataset.once === "true";
    const root = document.documentElement;
    if (!once) {
      try {
        sessionStorage.removeItem("intro-seen");
      } catch {}
    }
    root.classList.add("intro-lock");

    let closed = false;
    const finish = () => {
      if (closed) return;
      closed = true;
      clearTimeout(timer);
      el.classList.add("intro--out");
      root.classList.remove("intro-lock");
      if (once) {
        try {
          sessionStorage.setItem("intro-seen", "1");
        } catch {}
      }
      window.removeEventListener("keydown", finish);
      window.removeEventListener("wheel", finish);
      window.removeEventListener("touchmove", finish);
      el.removeEventListener("click", finish);
      setTimeout(() => el.remove(), 650);
    };

    const timer = setTimeout(finish, dur);
    window.addEventListener("keydown", finish, { passive: true });
    window.addEventListener("wheel", finish, { passive: true });
    window.addEventListener("touchmove", finish, { passive: true });
    el.addEventListener("click", finish);

    // if the media fails to load, don't sit on a blank screen
    const media = el.querySelector("img, video");
    media?.addEventListener("error", () => setTimeout(finish, 200));
  }
</script>

<style>
  .intro {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: var(--paper);
    display: grid;
    place-items: center;
    opacity: 1;
    transition: opacity 0.6s ease;
  }
  .intro--out {
    opacity: 0;
    pointer-events: none;
  }
  :global(html.intro-off) .intro {
    display: none;
  }
  :global(html.intro-lock),
  :global(html.intro-lock body) {
    overflow: hidden;
  }

  .intro__stage {
    display: grid;
    place-items: center;
    padding: var(--space-8);
    animation: intro-in 0.5s ease both;
  }
  .intro__media {
    display: block;
    max-width: min(88vw, 760px);
    max-height: 78vh;
    width: auto;
    height: auto;
  }
  .intro__stage.is-pixel .intro__media {
    image-rendering: pixelated;
  }

  .intro__placeholder {
    text-align: center;
    display: grid;
    gap: var(--space-3);
  }
  .intro__placeholder span {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 9vw, 5rem);
    line-height: 1;
    color: var(--ink);
    text-shadow:
      0.05em 0 0 var(--glitch-a),
      -0.05em 0 0 var(--glitch-b);
    animation: intro-flick 1.1s steps(1, end) infinite;
  }
  .intro__placeholder em {
    font-family: var(--font-mono);
    font-style: normal;
    font-size: var(--text-xs);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .intro__skip {
    position: fixed;
    bottom: var(--space-6);
    right: var(--space-6);
    background: transparent;
    border: var(--border);
    border-radius: var(--radius-sm);
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    padding: var(--space-2) var(--space-3);
    cursor: pointer;
  }
  .intro__skip:hover {
    color: var(--ink);
    border-color: var(--accent);
  }

  @keyframes intro-in {
    from {
      opacity: 0;
      transform: scale(0.96);
    }
  }
  @keyframes intro-flick {
    0%,
    100% {
      text-shadow:
        0.05em 0 0 var(--glitch-a),
        -0.05em 0 0 var(--glitch-b);
    }
    45% {
      text-shadow:
        -0.08em 0.02em 0 var(--glitch-a),
        0.08em -0.02em 0 var(--glitch-b);
    }
    70% {
      text-shadow:
        0.03em -0.04em 0 var(--glitch-a),
        -0.03em 0.04em 0 var(--glitch-b);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .intro {
      display: none;
    }
  }
</style>
