---
/**
 * Headline text that "boots up" the first time it scrolls into view: the
 * whole string churns through the Minecraft pixel font with a red/cyan
 * chromatic split, then resolves left-to-right into the real text in the
 * page's normal face.
 *
 * Cursor-local glitching (hovering any text) is handled globally by
 * src/scripts/glitch.ts — this component is just the one-shot reveal.
 *
 * The real text is always the element's content (SEO, no-JS). Reduced-motion
 * viewers get the plain text with no animation.
 */
interface Props {
  text: string;
  as?: keyof HTMLElementTagNameMap;
  class?: string;
}
const { text, as: Tag = "span", class: className }: Props = Astro.props;
---

<Tag class:list={["glitch", className]} data-glitch data-text={text}>{text}</Tag>

<script>
  const GLYPHS = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789§#%&/\\<>=+*?!".split("");
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const rnd = () => GLYPHS[(Math.random() * GLYPHS.length) | 0];

  function reveal(el: HTMLElement) {
    const target = el.dataset.text ?? el.textContent ?? "";
    if (reduce) {
      el.textContent = target;
      return;
    }
    el.classList.add("px", "glitching");
    const total = 34; // frames — long, churny boot-up
    let frame = 0;
    const tick = () => {
      // resolve point sweeps across the string over the back half
      const progress = Math.max(0, (frame / total - 0.35) / 0.65);
      el.textContent = target
        .split("")
        .map((ch, i) => {
          if (ch === " ") return " ";
          return i / target.length < progress ? ch : rnd();
        })
        .join("");
      if (frame++ < total) {
        setTimeout(() => requestAnimationFrame(tick), 26);
      } else {
        el.textContent = target;
        el.classList.remove("px", "glitching");
      }
    };
    tick();
  }

  const io = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        if (e.isIntersecting) {
          reveal(e.target as HTMLElement);
          io.unobserve(e.target);
        }
      }
    },
    { threshold: 0.6 },
  );

  document
    .querySelectorAll<HTMLElement>("[data-glitch]")
    .forEach((el) => io.observe(el));
</script>

<style>
  .glitch {
    font-variant-ligatures: none;
  }
</style>
