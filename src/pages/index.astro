---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import SocialBar from "@/components/SocialBar.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import GlitchText from "@/components/GlitchText.astro";
import HoverImage from "@/components/HoverImage.astro";
import { site } from "@/data/site";

const projects = (await getCollection("projects", (p) => !p.data.draft && p.data.featured)).sort(
  (a, b) => a.data.order - b.data.order,
);

const experience = (await getCollection("experience")).sort((a, b) => a.data.order - b.data.order);
const current = experience.filter((e) => e.data.end === "Present");
---

<BaseLayout>
  <section class="intro container">
    <div class="intro__text">
      <p class="eyebrow">{site.role}</p>
      <GlitchText text={site.name} as="h1" class="intro__name" />
      <p class="intro__tagline">{site.tagline}</p>
      <SocialBar />
    </div>
    <div class="intro__portrait">
      {
        site.portrait ? (
          <HoverImage src={site.portrait} alt={site.fullName} width={736} height={736} loading="eager" />
        ) : (
          <span>/images/profile/</span>
        )
      }
    </div>
  </section>

  <section class="container split">
    <div class="split__now">
      <p class="eyebrow">// currently</p>
      <ul class="current">
        {
          current.map((e) => (
            <li>
              <a href={`/experience#${e.id}`}>{e.data.org}</a>
              <span> — {e.data.role}</span>
            </li>
          ))
        }
      </ul>
      <p class="block__more"><a href="/experience">Full experience & resume &rarr;</a></p>
    </div>

    <div class="split__crazy">
      <p class="eyebrow eyebrow--play">// crazy about &mdash; last 7 days</p>
      <img
        class="obsessed__img"
        src="/images/obsession/fighters.png"
        alt={`${site.obsession.label} — pixel art`}
        width="557"
        height="449"
        loading="lazy"
        decoding="async"
      />
      <p class="obsessed__note">{site.obsession.note}</p>
    </div>
  </section>

  <section class="container block">
    <SectionHeading
      eyebrow="Selected work"
      title="Projects"
      href="/projects"
      linkLabel="All projects"
    />
    <div class="grid">
      {projects.map((p) => <ProjectCard project={p} />)}
    </div>
  </section>
</BaseLayout>

<style>
  .intro {
    padding-top: var(--space-24);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-8) var(--space-12);
    align-items: start;
  }
  .intro__text {
    flex: 1 1 22rem;
    max-width: var(--content-width);
  }
  .intro__name {
    font-size: var(--text-3xl);
    margin: var(--space-3) 0;
  }
  .intro__tagline {
    font-size: var(--text-lg);
    color: var(--muted);
    margin-bottom: var(--space-8);
  }
  .intro__portrait {
    flex: 0 0 auto;
    width: 13rem;
    aspect-ratio: 1;
    border: var(--border);
    overflow: hidden;
    display: grid;
    place-items: center;
  }
  .intro__portrait:has(span) {
    background-color: var(--surface);
    background-image: var(--dither);
    background-size: var(--dither-size);
  }
  .intro__portrait :global(.hoverimg),
  .intro__portrait :global(.hoverimg img) {
    width: 100%;
    height: 100%;
  }
  .intro__portrait span {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--accent-2);
  }
  /* two columns: the professional "currently" and the playful "crazy about".
     the right column lines up flush with the hero portrait above it. */
  .split {
    margin-top: var(--space-16);
    display: grid;
    grid-template-columns: 1fr 20rem;
    gap: var(--space-8) var(--space-16);
    align-items: start;
  }
  .split__crazy {
    justify-self: end;
  }
  @media (max-width: 52rem) {
    .split {
      grid-template-columns: 1fr;
      gap: var(--space-10);
    }
    .split__crazy {
      justify-self: start;
      width: 100%;
      max-width: 22rem;
    }
  }
  .split .eyebrow {
    margin-bottom: var(--space-4);
  }

  .current {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }
  .current span {
    color: var(--muted);
  }
  .block__more {
    margin-top: var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }

  /* --- crazy about: different typeface, gamier tone --- */
  .eyebrow--play {
    font-family: var(--font-pixel);
    color: var(--accent);
    letter-spacing: 0.06em;
  }
  .obsessed__img {
    display: block;
    width: 100%;
    height: auto;
    border: var(--border);
    image-rendering: pixelated;
  }
  .obsessed__note {
    margin: var(--space-3) 0 0;
    font-family: var(--font-pixel);
    font-size: var(--text-base);
    line-height: 1.5;
    color: var(--accent);
    -webkit-font-smoothing: none;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr));
    gap: var(--space-6);
  }
</style>
