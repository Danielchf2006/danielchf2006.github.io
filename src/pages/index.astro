---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import SocialBar from "@/components/SocialBar.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import GlitchText from "@/components/GlitchText.astro";
import { site } from "@/data/site";
import { education } from "@/data/education";

const projects = (await getCollection("projects", (p) => !p.data.draft && p.data.featured)).sort(
  (a, b) => a.data.order - b.data.order,
);

const experience = (await getCollection("experience")).sort((a, b) => a.data.order - b.data.order);
const current = experience.filter((e) => e.data.end === "Present");
---

<BaseLayout>
  <section class="intro container container--prose">
    <p class="eyebrow">{site.role}</p>
    <GlitchText text={site.name} as="h1" class="intro__name" />
    <p class="intro__tagline">{site.tagline}</p>
    <SocialBar />
  </section>

  <section class="container container--prose block">
    <h2>Currently</h2>
    <ul class="current">
      {
        current.map((e) => (
          <li>
            <a href={`/experience#${e.id}`}>{e.data.org}</a>
            <span> — {e.data.role}</span>
          </li>
        ))
      }
    </ul>
    <p class="block__more"><a href="/experience">Full experience & resume →</a></p>
  </section>

  <section class="container container--prose block">
    <h2>Education</h2>
    {
      education.map((ed) => (
        <div class="edu">
          <p class="edu__school">{ed.school}</p>
          <p class="edu__degree">
            {ed.degree} · {ed.dates}
          </p>
          <ul>
            {ed.details.map((d) => (
              <li>{d}</li>
            ))}
          </ul>
        </div>
      ))
    }
  </section>

  <section class="container block">
    <SectionHeading
      eyebrow="Selected work"
      title="Projects"
      href="/projects"
      linkLabel="All projects"
    />
    <div class="grid">
      {projects.map((p) => <ProjectCard project={p} />)}
    </div>
  </section>
</BaseLayout>

<style>
  .intro {
    padding-top: var(--space-24);
  }
  .intro__name {
    font-size: var(--text-3xl);
    margin: var(--space-3) 0;
  }
  .intro__tagline {
    font-size: var(--text-lg);
    color: var(--muted);
    margin-bottom: var(--space-8);
  }
  .block {
    margin-top: var(--space-16);
  }
  .current {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }
  .current span {
    color: var(--muted);
  }
  .block__more {
    margin-top: var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }
  .edu__school {
    margin: 0;
    font-weight: 650;
  }
  .edu__degree {
    margin: var(--space-1) 0 var(--space-2);
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }
  .edu ul {
    margin: 0;
    padding-left: 1.1rem;
    font-size: var(--text-sm);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr));
    gap: var(--space-6);
  }
</style>
