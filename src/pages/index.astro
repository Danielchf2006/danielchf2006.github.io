---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import SocialBar from "@/components/SocialBar.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import GlitchText from "@/components/GlitchText.astro";
import HeroChart from "@/components/HeroChart.astro";
import { site } from "@/data/site";

const projects = (await getCollection("projects", (p) => !p.data.draft && p.data.featured)).sort(
  (a, b) => a.data.order - b.data.order,
);

const experience = (await getCollection("experience")).sort((a, b) => a.data.order - b.data.order);
const current = experience.filter((e) => e.data.end === "Present");
---

<BaseLayout>
  <section class="intro container">
    <div class="intro__text container--prose">
      <p class="eyebrow">{site.role}</p>
      <GlitchText text={site.name} as="h1" hoverFont="serif" class="intro__name" />
      <p class="intro__tagline">{site.tagline}</p>
      <SocialBar />
    </div>
    <div class="intro__chart">
      <HeroChart />
    </div>
  </section>

  <section class="container container--prose block">
    <h2>Currently</h2>
    <ul class="current">
      {
        current.map((e) => (
          <li>
            <a href={`/experience#${e.id}`}>{e.data.org}</a>
            <span> — {e.data.role}</span>
          </li>
        ))
      }
    </ul>
    <p class="block__more"><a href="/experience">Full experience & resume →</a></p>
  </section>

  <section class="container block">
    <SectionHeading
      eyebrow="Selected work"
      title="Projects"
      href="/projects"
      linkLabel="All projects"
    />
    <div class="grid">
      {projects.map((p) => <ProjectCard project={p} />)}
    </div>
  </section>
</BaseLayout>

<style>
  .intro {
    padding-top: var(--space-24);
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-12);
    align-items: center;
  }
  .intro__name {
    font-size: var(--text-3xl);
    margin: var(--space-3) 0;
  }
  .intro__tagline {
    font-size: var(--text-lg);
    color: var(--muted);
    margin-bottom: var(--space-8);
  }
  .intro__chart {
    max-width: 34rem;
    width: 100%;
    justify-self: center;
  }
  @media (min-width: 60rem) {
    .intro {
      grid-template-columns: 1.05fr 0.95fr;
      gap: var(--space-16);
    }
    .intro__chart {
      justify-self: end;
    }
  }
  .block {
    margin-top: var(--space-16);
  }
  .current {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }
  .current span {
    color: var(--muted);
  }
  .block__more {
    margin-top: var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr));
    gap: var(--space-6);
  }
</style>
