---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import SocialBar from "@/components/SocialBar.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import GlitchText from "@/components/GlitchText.astro";
import HeroChart from "@/components/HeroChart.astro";
import HoverImage from "@/components/HoverImage.astro";
import { site } from "@/data/site";

const projects = (await getCollection("projects", (p) => !p.data.draft && p.data.featured)).sort(
  (a, b) => a.data.order - b.data.order,
);

const experience = (await getCollection("experience")).sort((a, b) => a.data.order - b.data.order);
const current = experience.filter((e) => e.data.end === "Present");
---

<BaseLayout>
  <section class="intro container">
    <div class="intro__text">
      <p class="eyebrow">{site.role}</p>
      <GlitchText text={site.name} as="h1" class="intro__name" />
      <p class="intro__tagline">{site.tagline}</p>
      <SocialBar />
    </div>
    <div class="intro__portrait">
      {
        site.portrait ? (
          <HoverImage src={site.portrait} alt={site.fullName} width={480} height={600} loading="eager" />
        ) : (
          <span>/images/profile/</span>
        )
      }
    </div>
  </section>

  <section class="container chartband">
    <p class="eyebrow">// model output</p>
    <HeroChart />
  </section>

  <section class="container container--prose block">
    <h2>Currently</h2>
    <ul class="current">
      {
        current.map((e) => (
          <li>
            <a href={`/experience#${e.id}`}>{e.data.org}</a>
            <span> — {e.data.role}</span>
          </li>
        ))
      }
    </ul>
    <p class="block__more"><a href="/experience">Full experience & resume →</a></p>
  </section>

  <section class="container block">
    <SectionHeading
      eyebrow="Selected work"
      title="Projects"
      href="/projects"
      linkLabel="All projects"
    />
    <div class="grid">
      {projects.map((p) => <ProjectCard project={p} />)}
    </div>
  </section>
</BaseLayout>

<style>
  .intro {
    padding-top: var(--space-24);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-8) var(--space-12);
    align-items: start;
  }
  .intro__text {
    flex: 1 1 22rem;
    max-width: var(--content-width);
  }
  .intro__name {
    font-size: var(--text-3xl);
    margin: var(--space-3) 0;
  }
  .intro__tagline {
    font-size: var(--text-lg);
    color: var(--muted);
    margin-bottom: var(--space-8);
  }
  .intro__portrait {
    flex: 0 0 auto;
    width: 12rem;
    aspect-ratio: 4 / 5;
    border: var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    background-color: var(--surface);
    background-image: var(--dither);
    background-size: var(--dither-size);
    display: grid;
    place-items: center;
  }
  .intro__portrait span {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--accent-2);
  }
  .chartband {
    margin-top: var(--space-12);
    max-width: 44rem;
  }
  .chartband .eyebrow {
    margin-bottom: var(--space-4);
  }
  .block {
    margin-top: var(--space-16);
  }
  .current {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }
  .current span {
    color: var(--muted);
  }
  .block__more {
    margin-top: var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr));
    gap: var(--space-6);
  }
</style>
