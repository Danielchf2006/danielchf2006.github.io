---
import { getCollection, render } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import ExperienceItem from "@/components/ExperienceItem.astro";
import { site } from "@/data/site";

const entries = (await getCollection("experience")).sort(
  (a, b) => a.data.order - b.data.order,
);

const rendered = await Promise.all(
  entries.map(async (entry) => ({ entry, Content: (await render(entry)).Content })),
);
---

<BaseLayout title="Experience" description={`${site.name} — experience and resume.`}>
  <section class="head container container--prose">
    <p class="eyebrow">Resume</p>
    <h1>Experience</h1>
    <p class="head__lead">
      The web version of my resume. For the one-page PDF — education included —
      use the button below.
    </p>
    <p class="head__actions">
      <a class="btn" href={site.resumePath} target="_blank" rel="noopener">
        Download resume (PDF)
      </a>
    </p>
  </section>

  <section class="container container--prose section">
    {rendered.map(({ entry, Content }) => (
      <ExperienceItem entry={entry}>
        <Content />
      </ExperienceItem>
    ))}
  </section>
</BaseLayout>

<style>
  .head {
    padding-top: var(--space-16);
  }
  .head__lead {
    color: var(--muted);
  }
  .head__actions {
    margin-top: var(--space-6);
  }
  .btn {
    display: inline-block;
    background: var(--accent);
    color: var(--paper);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 700;
    padding: var(--space-3) var(--space-6);
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow);
  }
  .btn:hover {
    text-decoration: none;
    background: var(--accent-2);
    box-shadow: var(--shadow-lift);
  }
  .section {
    padding-top: var(--space-8);
  }
</style>
