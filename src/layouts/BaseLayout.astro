---
import "@/styles/global.css";
import Nav from "@/components/Nav.astro";
import Footer from "@/components/Footer.astro";
import IntroOverlay from "@/components/IntroOverlay.astro";
import { site } from "@/data/site";

interface Props {
  title?: string;
  description?: string;
  /** hide the site nav (e.g. a future landing variant) */
  bareHeader?: boolean;
}

const {
  title,
  description = site.tagline,
  bareHeader = false,
} = Astro.props;

const pageTitle = title ? `${title} · ${site.name}` : `${site.name} — ${site.role}`;
const canonical = new URL(Astro.url.pathname, site.url).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link
      rel="preload"
      href="/fonts/Monocraft.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title ?? site.name} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL("/images/og/og.png", site.url).href} />
    <meta name="twitter:card" content="summary_large_image" />

    {/* set theme + decide intro visibility before first paint (no flash) */}
    <script is:inline>
      (function () {
        var root = document.documentElement;
        try {
          var t = localStorage.getItem("theme");
          if (t === "light" || t === "dark") root.setAttribute("data-theme", t);
        } catch (e) {}
        try {
          var skip =
            window.matchMedia("(prefers-reduced-motion: reduce)").matches ||
            sessionStorage.getItem("intro-seen") === "1";
          if (skip) root.classList.add("intro-off");
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <div class="crt" aria-hidden="true"></div>
    <IntroOverlay />
    <a class="skip-link" href="#main">Skip to content</a>
    {!bareHeader && <Nav />}
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      import "@/scripts/glitch.ts";
      import "@/scripts/oneko.ts";
    </script>
  </body>
</html>
